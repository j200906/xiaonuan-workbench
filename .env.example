# 小暖 · 环境变量模板
#
# 用法：复制成 .env（cp .env.example .env），按需取消注释并填值；.env 别提交。
# 约定：只写「要设的值」。不需要的变量请整行注释掉，不要留成 `XN_XXX=`——
#       本地启动脚本会区分「没有这项」和「空值」，空值会把默认值顶掉。
#
# 谁读它：
#   - 本地后端 server/app.py、一键启动 scripts/local_boot.py、scripts/deploy_hf.py
#   - 部署脚本 cloudflare/deploy_pages.mjs（也会读本文件）
# 注意：边缘（Cloudflare Pages / Workers）的变量是另一份，要在 Pages 项目的
#       Settings → Variables and Secrets 里配置；本地 .env 不会影响线上，
#       deploy_pages.mjs --env 也只同步它认识的那批键（见 README「环境变量」）。

# ---------- 模型 ----------
# 留空即用本机 magpie 网关 http://127.0.0.1:3425/v1（由 scripts/local_boot.py 兜底）；
# 想换网关 / 换模型就取消注释。边缘变量不读这两项以外的默认值。
# XN_BASE=http://127.0.0.1:3425/v1
# XN_MODEL=marvis/deepseek-v4-1-flash-261017
# 服务器自己的模型 Key（可选）。只在服务端用，不会进浏览器
# XN_API_KEY=
# 服务端 Key 允许的模型，逗号分隔（不设就用 XN_MODEL）
# XN_ALLOWED_MODELS=

# ---------- 管理会话 ----------
# 管理密码：只在 POST /api/admin/verify 用一次，换 12 小时 HMAC 令牌。
# 不设的话，start-local 第一次运行会当场问你一次（只存在本次进程）。
# XN_ADMIN_PASSWORD=
# 令牌签名密钥：不填就复用管理密码；建议单独设一个随机串
# XN_ADMIN_SECRET=
# 【边缘】令牌版本：改成 2 会立刻吊销所有已发的管理会话，不用等过期
# XN_ADMIN_TOKEN_VERSION=1

# ---------- 同源 / CSRF ----------
# 额外允许的跨站来源，逗号分隔；不设只允许同源
# XN_ALLOWED_ORIGINS=
# 【边缘】XN_REQUIRE_ORIGIN 设 1/true 时缺 Origin 也拒绝（只给浏览器用的部署建议开）
# XN_REQUIRE_ORIGIN=1
# 【本地】设 1 才信 X-Forwarded-For；确实是反向代理后面才开，否则限流可被伪造头绕过
# XN_TRUST_PROXY=1

# ---------- 发布仓库与 GitHub Token ----------
# 锁定自迭代能提交的仓库（线上环境变量里设，客户端传的 owner/repo 一律忽略）
# XN_REPO_OWNER=j200906
# XN_REPO_NAME=xiaonuan-workbench
# GitHub Token（可选）：只在服务端用，浏览器不持有、也没有输入框；本地模式不需要
# XN_GH_TOKEN=

# ---------- 本机网关（下发给前端的自迭代模型）----------
# 留空由 scripts/local_boot.py 兜底成 127.0.0.1:3425
# XN_GATEWAY_BASE=http://127.0.0.1:3425/v1
# XN_GATEWAY_MODEL=marvis/deepseek-v4-1-flash-261017
# 【边缘】走网关时带的 Key；本机 3425 一般留空
# XN_GATEWAY_KEY=
# 【边缘】设 1 才认 http://127.0.0.1 的网关（默认只认 https）
# XN_ALLOW_LOCAL_GATEWAY=1
# 额外允许的模型主机（如隧道域名），逗号分隔，最多 8 个
# XN_EXTRA_HOSTS=

# ---------- 自迭代 ----------
# 【边缘】没有外部 Key、网关也不可用时，云端退回的 Workers AI 模型
# XN_ITER_MODEL=@cf/zai-org/glm-4.7-flash
# 【边缘】自带 Workers AI 模型的覆盖值（默认 GLM-4.7-Flash）
# XN_AI_MODEL=
# 【边缘】解锁后自迭代提交 / 打 tag 的目标分支；不设 = 仓库默认分支
# XN_ITER_BRANCH=
# 【边缘】未解锁时的试跑分支，默认 iterate/public
# XN_PUBLIC_ITERATE_BRANCH=iterate/public
# 本地自迭代成功后自动 git commit（1 = 自动，默认 0 只改文件不提交）
XN_AUTO_COMMIT=0

# ---------- 反馈与本地数据 ----------
# 【边缘】云端反馈保留天数，默认 180，范围 1–365
# XN_FEEDBACK_TTL_DAYS=180
# 本地反馈 / 备份目录，默认 ./data
# XN_DATA_DIR=
# start-local 起的端口，默认 8080
XN_PORT=8080

# ---------- 隧道工具 ----------
# 本机网关出口代理的钥匙（优先于 tools/tunnel-key.txt）
# XN_TUNNEL_KEY=

# ---------- Cloudflare 部署（deploy_pages.mjs 用，不要写进 Worker 变量）----------
# 只跑 dry-run 可以不填；真要 --apply 才需要这两个（没有就明确报缺哪一项）
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# KV 命名空间 id：npx wrangler kv namespace create XN_KV 的输出
# XN_KV_ID=
# Pages 项目名，默认 xiaonuan-app
XN_PAGES_PROJECT=xiaonuan-app
